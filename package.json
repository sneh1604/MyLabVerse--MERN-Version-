{
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "vite",
    "build": "npm run build:server && npm run build:client",
    "build:server": "cd server && npm install",
    "build:client": "cd client && npm install && npm run build",
    "start": "cd server && node index.js",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "test": "jest --watchAll"
  },
  "dependencies": {
    "@google/generative-ai": "^1.0.0",
    "axios": "^0.27.2",
    "bcryptjs": "^2.4.3",
    "chart.js": "^3.7.1",
    "concurrently": "^6.2.1",
    "cookie-parser": "^1.4.5",
    "cors": "^2.8.5",
    "dotenv": "^10.0.0",
    "express": "^4.17.1",
    "jest": "^27.0.6",
    "jsonwebtoken": "^8.5.1",
    "mongoose": "^6.0.12",
    "multer": "^1.4.3",
    "nodemon": "^3.1.9",
    "pillow": "^8.4.0",
    "pytesseract": "^0.3.8",
    "xlsx": "^0.17.0"
  },
  "devDependencies": {
    "@types/jest": "^27.0.2",
    "@types/node": "^16.11.7",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "prettier": "^2.5.1",
    "ts-node": "^10.4.0",
    "typescript": "^4.5.2"
  }
}